# ------------------------------
# ROS 2 Humble / Colcon
# ------------------------------

# Colcon build artifacts
build/
install/
log/

# colcon test results
test_results/

# Python bytecode
__pycache__/
*.pyc
*.pyo

# C/C++ build files
*.o
*.so
*.a
*.out

# ROS 2 parameters cache
*.yaml~

# ------------------------------
# VSCode / IDE-specific
# ------------------------------

# VSCode config
.vscode/
.history/

# CLion / JetBrains
.idea/
cmake-build-*/

# QtCreator
*.user

# ------------------------------
# System / OS ignoring
# ------------------------------

# macOS system files
.DS_Store
.AppleDouble
.LSOverride

# Linux / other junk
Thumbs.db
desktop.ini

# ------------------------------
# Python venv
# ------------------------------

venv/
env/
*.egg-info/
.eggs/

# ------------------------------
# Launch / bag files
# ------------------------------

# rosbag2 files
*.db3
*.mcap
*.yaml   # auto-generated rosbag metadata
rosbag*/
# Temporary log files
*.log

# ------------------------------
# Other common ROS stuff
# ------------------------------

# RViz, Gazebo temporary data
rviz/*.rviz~
.gazebo/
gz-transport/

# colcon metadata cache
.colcon/

# Local config backups
*.bak
*.swp
*.swo
frames_*.gv
frames_*.pdf
docs/

# Perception model code + weights (Contact-GraspNet, GroundingDINO, SAM): large, not tracked
perception_tests/

# ------------------------------
# Package repos (managed by steve.repos / scripts/repos.sh)
# ------------------------------
# Every package in src/ is its own clone; none are tracked in this repo.
src/*

# pixi environments
.pixi/*
!.pixi/config.toml

# Mac (pixi) colcon builds
build_mac/
install_mac/
log_mac/

# LaTeX auxiliary files
*.aux
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz
