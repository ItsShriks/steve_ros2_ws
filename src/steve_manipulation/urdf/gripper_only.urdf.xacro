<?xml version="1.0"?>
<!--
  Gripper-only description for the real robot's stand-alone gripper_controller_manager.
  Contains just the Robotiq 2F-85 ros2_control block, so this controller manager never
  opens the UR hardware interface (that one belongs to ur_robot_driver).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="steve_gripper">
    <xacro:arg name="gripper_hw" default="mock"/>
    <xacro:arg name="com_port" default="/tmp/ttyUR"/>
    <xacro:include filename="$(find steve_simulation)/components/gripper/robotiq_2f_85.urdf.xacro"/>
    <link name="ur5etool0"/>
    <xacro:steve_robotiq_2f_85 parent="ur5etool0" gripper_hw="$(arg gripper_hw)" com_port="$(arg com_port)"/>
</robot>
