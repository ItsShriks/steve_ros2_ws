        <joint name="ur5ewrist_2_joint" value="-1.57"/>
        <joint name="ur5ewrist_3_joint" value="0.0"/>
    </group_state>
    <group_state name="table_reach" group="ur_manipulator">
        <joint name="ur5eshoulder_pan_joint" value="0.0"/>
