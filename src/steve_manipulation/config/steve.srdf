        <joint name="ur5ewrist_2_joint" value="-1.57"/>
        <joint name="ur5ewrist_3_joint" value="0.0"/>
    </group_state>
    <group_state name="forward" group="ur_manipulator">
        <joint name="ur5eshoulder_pan_joint" value="0.0"/>
        <joint name="ur5eshoulder_lift_joint" value="-1.558"/>
        <joint name="ur5eelbow_joint" value="2.075"/>
        <joint name="ur5ewrist_1_joint" value="-0.516"/>
        <joint name="ur5ewrist_2_joint" value="1.571"/>
        <joint name="ur5ewrist_3_joint" value="0.0"/>
    </group_state>
    <group_state name="open" group="gripper">
        <joint name="robotiq_85_left_knuckle_joint" value="0.0"/>
    </group_state>
    <group_state name="closed" group="gripper">
        <joint name="robotiq_85_left_knuckle_joint" value="0.7929"/>
    </group_state>

    <end_effector name="robotiq_2f_85" parent_link="robotiq_85_base_link" group="gripper" parent_group="ur_manipulator"/>

