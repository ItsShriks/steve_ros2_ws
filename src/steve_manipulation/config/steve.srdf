<!-- Generated by tools/generate_srdf.py from the MMO-700 + UR5e + Robotiq 2F-85 URDF. -->
<robot name="mmo_700">
    <!-- Arm: UR5e base to the gripper tool centre point -->
    <group name="ur_manipulator">
        <chain base_link="ur5ebase_link" tip_link="gripper_tcp"/>
    </group>
    <group name="gripper">
        <joint name="robotiq_85_left_knuckle_joint"/>
    </group>

    <group_state name="home" group="ur_manipulator">
        <joint name="ur5eshoulder_pan_joint" value="0.0"/>
        <joint name="ur5eshoulder_lift_joint" value="-1.5708"/>
        <joint name="ur5eelbow_joint" value="1.5708"/>
