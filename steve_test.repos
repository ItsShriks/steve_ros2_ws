# Package repositories cloned into src/ (vcstool-compatible).
# `url` is the GitLab repository, `github` its GitHub copy: repos.sh fetches from one host (the one the
# workspace was cloned from, or $REPOS_HOST) and pushes to both. `version` is the branch each package
# tracks. Change it here to switch branches.
# Sync with:  ./scripts/repos.sh sync test   (or: git go-test)
repositories:
  steve_perception:
    type: git
    url: git@gitlab.igg.uni-bonn.de:hrl_software/steve-moma/steve_perception.git
    github: git@github.com:pratik-adhikari/steve_perception.git
    version: test
  steve_pan_tilt_controller:
    type: git
    url: git@gitlab.igg.uni-bonn.de:hrl_software/steve-moma/steve_pan_tilt_controller.git
    github: git@github.com:RiddheshMore/steve_pan_tilt_controller.git
    version: test
  steve_hardware_bringup:
    type: git
    url: git@gitlab.igg.uni-bonn.de:hrl_software/steve-moma/steve_hardware_bringup.git
    github: git@github.com:ItsShriks/steve_hardware_bringup.git
    version: test
  steve_simulation:
    type: git
    url: git@gitlab.igg.uni-bonn.de:hrl_software/steve-moma/steve_simulation.git
    github: git@github.com:ItsShriks/steve_simulation.git
    version: test
  steve_navigation:
    type: git
    url: git@gitlab.igg.uni-bonn.de:hrl_software/steve-moma/steve_navigation.git
    github: git@github.com:ItsShriks/steve_navigation.git
    version: test
  steve_essentials:
    type: git
    url: git@gitlab.igg.uni-bonn.de:hrl_software/steve-moma/steve_essentials.git
    github: git@github.com:ItsShriks/steve_essentials.git
    version: test
  steve_manipulation:
    type: git
    url: git@gitlab.igg.uni-bonn.de:hrl_software/steve-moma/steve_manipulation.git
    github: git@github.com:ItsShriks/steve_manipulation.git
    version: test
  steve_wbc:
    type: git
    url: git@gitlab.igg.uni-bonn.de:hrl_software/steve-moma/steve_wbc.git
    github: git@github.com:ItsShriks/steve_wbc.git
    version: test
  steve_grasping:
    type: git
    url: git@gitlab.igg.uni-bonn.de:hrl_software/steve-moma/steve_grasping.git
    github: git@github.com:ItsShriks/steve_grasping.git
    version: test
  steve_command_grounding:
