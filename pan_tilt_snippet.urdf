  <!-- Pan-Tilt Unit -->
  <link name="pan_tilt_base_link">
    <visual>
      <geometry>
        <box size="0.1 0.1 0.05"/>
      </geometry>
      <material name="black">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.1 0.1 0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="pan_tilt_base_joint" type="fixed">
    <parent link="base_link"/>
    <child link="pan_tilt_base_link"/>
    <origin xyz="0.3 0.0 0.4" rpy="0 0 0"/>
  </joint>

  <link name="pan_motor_link">
    <visual>
      <geometry>
        <cylinder radius="0.03" length="0.06"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.03" length="0.06"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="pan_joint" type="revolute">
    <parent link="pan_tilt_base_link"/>
    <child link="pan_motor_link"/>
    <origin xyz="0.0 0.0 0.03" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="10.0" velocity="1.0"/>
  </joint>

  <link name="tilt_motor_link">
    <visual>
      <geometry>
        <cylinder radius="0.03" length="0.06"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.03" length="0.06"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="tilt_joint" type="revolute">
    <parent link="pan_motor_link"/>
    <child link="tilt_motor_link"/>
    <origin xyz="0.0 0.0 0.05" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10.0" velocity="1.0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.06 0.09 0.03"/>
      </geometry>
      <material name="camera_blue">
        <color rgba="0.1 0.3 0.6 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.06 0.09 0.03"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="tilt_motor_link"/>
    <child link="camera_link"/>
    <origin xyz="0.05 0.0 0.0" rpy="0 0 0"/>
  </joint>

  <!-- Camera optical frames for RealSense L515 -->
  <link name="pan_tilt_camera_link"/>
  
  <joint name="pan_tilt_camera_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="pan_tilt_camera_link"/>
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
  </joint>

  <link name="pan_tilt_camera_color_optical_frame"/>
  
  <joint name="pan_tilt_camera_color_optical_joint" type="fixed">
    <parent link="pan_tilt_camera_link"/>
    <child link="pan_tilt_camera_color_optical_frame"/>
    <origin xyz="0.0 0.0 0.0" rpy="-1.57 0 -1.57"/>
  </joint>

  <link name="pan_tilt_camera_depth_optical_frame"/>
  
  <joint name="pan_tilt_camera_depth_optical_joint" type="fixed">
    <parent link="pan_tilt_camera_link"/>
    <child link="pan_tilt_camera_depth_optical_frame"/>
    <origin xyz="0.0 0.0 0.0" rpy="-1.57 0 -1.57"/>
  </joint>

</robot>
